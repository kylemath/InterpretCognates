\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Conceptual Store Metric (CSM; ratio of mean between-concept centroid cosine distance to mean within-concept cross-lingual cosine distance) across 101{} Swadesh concepts and 135{} languages, comparing raw vs.\ language-centered embeddings under both extraction regimes against the concept-permutation null ($\text  {CSM}_{\text  {null}} = 1.01{}$, dashed grey line). Error bars denote 95\% bootstrap confidence intervals ($1{,}000$ non-self concept resamples). Decontextualized bare words exhibit strong raw language-identity offsets ($\text  {CSM} = 1.15{}$) that are removed by per-language mean-centering ($2.46{}$, a $2.14{}\times $ improvement), converging to nearly the same language-independent conceptual store as the shared carrier frame ($2.25{} \to 2.69{}$, $1.19{}\times $).}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:conceptual_store}{{2}{10}{Conceptual Store Metric (CSM; ratio of mean between-concept centroid cosine distance to mean within-concept cross-lingual cosine distance) across \NumConcepts {} Swadesh concepts and \NumLanguages {} languages, comparing raw vs.\ language-centered embeddings under both extraction regimes against the concept-permutation null ($\text {CSM}_{\text {null}} = \CSMPermNull {}$, dashed grey line). Error bars denote 95\% bootstrap confidence intervals ($1{,}000$ non-self concept resamples). Decontextualized bare words exhibit strong raw language-identity offsets ($\text {CSM} = \ConceptualStoreBareRaw {}$) that are removed by per-language mean-centering ($\ConceptualStoreBareCentered {}$, a $\ConceptualStoreBareImprovement {}\times $ improvement), converging to nearly the same language-independent conceptual store as the shared carrier frame ($\ConceptualStoreRaw {} \to \ConceptualStoreCentered {}$, $\ConceptualStoreImprovement {}\times $)}{figure.caption.8}{}}
\citation{voita2019,voita2021,tenney2019}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Layer-wise emergence of cross-lingual semantic structure across all 12{} encoder layers on the 39{}-language typologically balanced subset. (a) Mean Swadesh convergence rises from $0.35{}$ at the first encoder block (Layer~0), exhibits its steepest single-layer gain at Layer~1{}, reaches peak cross-lingual alignment at Layer~10{} ($\mu = 0.86{}$), and dips slightly at the final encoder layer (Layer~11, $\mu = 0.80{}$) as representations specialize for decoder cross-attention. (b) Raw and language-centered CSM across layers, with the steepest inflection in centered concept separability occurring at Layer~6{} and reaching $4.01{}$ at Layer~11. (c) Per-concept convergence heatmap across layers for the 17 highest- and 18 lowest-converging Swadesh concepts (sorted from highest to lowest final convergence), showing that concrete nouns and natural phenomena align several layers earlier than abstract or polysemous items.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:layerwise}{{3}{11}{Layer-wise emergence of cross-lingual semantic structure across all \LayerwiseNumLayers {} encoder layers on the \LayerwiseNumLangs {}-language typologically balanced subset. (a) Mean Swadesh convergence rises from $\LayerwiseInputConv {}$ at the first encoder block (Layer~0), exhibits its steepest single-layer gain at Layer~\LayerwiseEmergenceLayer {}, reaches peak cross-lingual alignment at Layer~\LayerwisePeakLayer {} ($\mu = \LayerwisePeakConv {}$), and dips slightly at the final encoder layer (Layer~11, $\mu = \LayerwiseFinalConv {}$) as representations specialize for decoder cross-attention. (b) Raw and language-centered CSM across layers, with the steepest inflection in centered concept separability occurring at Layer~\LayerwisePhaseTrans {} and reaching $\LayerwiseFinalCSM {}$ at Layer~11. (c) Per-concept convergence heatmap across layers for the 17 highest- and 18 lowest-converging Swadesh concepts (sorted from highest to lowest final convergence), showing that concrete nouns and natural phenomena align several layers earlier than abstract or polysemous items}{figure.caption.9}{}}
