\@writefile{toc}{\contentsline {paragraph}{Berlin \& Kay Evolutionary Color Hierarchy.}{22}{section*.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Cross-lingual geometry of the 11{} \citet  {berlin1969} basic color terms across 135{} languages. (a) Projection onto the PC1--PC2 plane ($22.8{}\% + 16.3{}\% = 39.1{}\%$ of centroid variance): small translucent points denote per-language embeddings, shaded hulls denote cross-lingual dispersion, and large prominent markers denote cross-lingual centroids. PC2 separates warm hues (\emph  {red, yellow, orange}) from cool hues (\emph  {blue, green}). (b) PC1 coordinate vs.\ \citet  {berlin1969} evolutionary stage (Stage~I: \emph  {white, black}; Stage~II: \emph  {red}; Stages~III--IV: \emph  {yellow, green}; Stage~V: \emph  {blue}; Stage~VI: \emph  {brown}; Stage~VII: \emph  {purple, pink, orange}; with \emph  {grey} shown as an open diamond at its midpoint stage~$5.0$ representing its wildcard Stage~III--VII status). PC1 directly recovers the typological lexicalization hierarchy ($\rho _s = 0.93{}$, $p = 8.48 \times 10^{-5}{}$; Pearson $r = 0.89{}$, $p = 2.83 \times 10^{-4}{}$).}}{22}{figure.caption.21}\protected@file@percent }
\newlabel{fig:color}{{14}{22}{Cross-lingual geometry of the \ColorNumColors {} \citet {berlin1969} basic color terms across \ColorNumLanguages {} languages. (a) Projection onto the PC1--PC2 plane ($\ColorPConeVar {}\% + \ColorPCtwoVar {}\% = \ColorPConeTwoVar {}\%$ of centroid variance): small translucent points denote per-language embeddings, shaded hulls denote cross-lingual dispersion, and large prominent markers denote cross-lingual centroids. PC2 separates warm hues (\emph {red, yellow, orange}) from cool hues (\emph {blue, green}). (b) PC1 coordinate vs.\ \citet {berlin1969} evolutionary stage (Stage~I: \emph {white, black}; Stage~II: \emph {red}; Stages~III--IV: \emph {yellow, green}; Stage~V: \emph {blue}; Stage~VI: \emph {brown}; Stage~VII: \emph {purple, pink, orange}; with \emph {grey} shown as an open diamond at its midpoint stage~$5.0$ representing its wildcard Stage~III--VII status). PC1 directly recovers the typological lexicalization hierarchy ($\rho _s = \ColorBKRho {}$, $p = \ColorBKP {}$; Pearson $r = \ColorBKR {}$, $p = \ColorBKRp {}$)}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {paragraph}{Semantic Offset Invariance and Distance-Controlled Residuals.}{23}{section*.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Cross-lingual semantic offset invariance and baseline distance control across 135{} languages. (a) Raw offset consistency $S(a,b)$ across 15{} semantic pairs (blue bars, led by \emph  {fire--water{}} at $0.94{}$) and 7{} unrelated cross-domain negative controls (red bars, e.g., \emph  {tree--red, stone--sleep, seed--night}). (b) Raw offset consistency correlates strongly with baseline centroid separation $\|\hat  {\boldsymbol  {\mu }}_b - \hat  {\boldsymbol  {\mu }}_a\|_2$ ($r = 0.84{}$, $p = 1.03 \times 10^{-6}{}$) because subtracting two embeddings cancels the shared language vector $\hat  {\boldsymbol  {\ell }}$. Relative to the OLS regression line, semantic pairs exhibit significantly positive residual consistency ($\mu _{\text  {resid}} = +0.012{}$, led by \emph  {man--woman{}}, \emph  {big--small}, and \emph  {fire--water}) whereas negative controls fall consistently below the trend ($\mu _{\text  {resid}} = -0.025{}$; Mann-Whitney $U = 90{}$, $p = 0.003{}$, Cohen's $d = 1.06{}$).}}{24}{figure.caption.23}\protected@file@percent }
\newlabel{fig:offset}{{15}{24}{Cross-lingual semantic offset invariance and baseline distance control across \NumLanguages {} languages. (a) Raw offset consistency $S(a,b)$ across \OffsetSemanticCount {} semantic pairs (blue bars, led by \emph {\OffsetBestPair {}} at $\OffsetBestSemanticVal {}$) and \OffsetControlCount {} unrelated cross-domain negative controls (red bars, e.g., \emph {tree--red, stone--sleep, seed--night}). (b) Raw offset consistency correlates strongly with baseline centroid separation $\|\hat {\boldsymbol {\mu }}_b - \hat {\boldsymbol {\mu }}_a\|_2$ ($r = \OffsetNormCorrR {}$, $p = \OffsetNormCorrP {}$) because subtracting two embeddings cancels the shared language vector $\hat {\boldsymbol {\ell }}$. Relative to the OLS regression line, semantic pairs exhibit significantly positive residual consistency ($\mu _{\text {resid}} = +\OffsetResidSemanticMean {}$, led by \emph {\OffsetBestResidPair {}}, \emph {big--small}, and \emph {fire--water}) whereas negative controls fall consistently below the trend ($\mu _{\text {resid}} = \OffsetResidControlMean {}$; Mann-Whitney $U = \OffsetResidU {}$, $p = \OffsetResidP {}$, Cohen's $d = \OffsetResidCohenD {}$)}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Geometric visualization of cross-lingual offset vectors across all 15{} semantic pairs ($29$ unique concepts) and 135{} languages. (a) Joint PCA projection showing per-language embeddings (translucent points), cross-lingual concept centroids (white markers), per-language difference vectors (thin colored arrows), and centroid offset vectors $\hat  {\boldsymbol  {\mu }}_b - \hat  {\boldsymbol  {\mu }}_a$ (bold arrows), revealing macro-level clustering into nature, animal, body/person, action, and property/pronoun regions alongside local relational offsets. (b) Per-language and centroid offset vectors translated to a common origin, illustrating directional bundling around each pair's relational axis.}}{25}{figure.caption.24}\protected@file@percent }
\newlabel{fig:offset_vector_demo}{{16}{25}{Geometric visualization of cross-lingual offset vectors across all \OffsetSemanticCount {} semantic pairs ($29$ unique concepts) and \NumLanguages {} languages. (a) Joint PCA projection showing per-language embeddings (translucent points), cross-lingual concept centroids (white markers), per-language difference vectors (thin colored arrows), and centroid offset vectors $\hat {\boldsymbol {\mu }}_b - \hat {\boldsymbol {\mu }}_a$ (bold arrows), revealing macro-level clustering into nature, animal, body/person, action, and property/pronoun regions alongside local relational offsets. (b) Per-language and centroid offset vectors translated to a common origin, illustrating directional bundling around each pair's relational axis}{figure.caption.24}{}}
