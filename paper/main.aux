\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Pairwise NLLB-200 embedding distance vs.\ ASJP lexical phonetic distance across 88{} languages ($3828{}$ pairs), stratified by genealogical relationship tier. Within language subfamilies (blue, $n = 321{}$ pairs), embedding distance correlates strongly with phonetic distance ($\rho _s = 0.65{}$, block-permutation $p = 1.00 \times 10^{-4}{}$, dyadic $p = 2.40 \times 10^{-40}{}$). Across Indo-European branches (amber, $n = 374{}$), correlation weakens ($\rho _s = 0.10{}$), and across unrelated language families (red, $n = 3133{}$), ASJP distance saturates near ceiling ($\rho _s = 0.04{}$). Pooled carrier-frame Mantel $\rho _s = 0.13{}$ ($p = 0.020{}$); decontextualized bare-word Mantel $\rho _s = 0.24{}$ ($p = 0.001{}$).}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:mantel_scatter}{{12}{19}{Pairwise NLLB-200 embedding distance vs.\ ASJP lexical phonetic distance across \MantelNumLangs {} languages ($\MantelTotalPairs {}$ pairs), stratified by genealogical relationship tier. Within language subfamilies (blue, $n = \MantelWithinSubfamilyPairs {}$ pairs), embedding distance correlates strongly with phonetic distance ($\rho _s = \MantelWithinSubfamilyRho {}$, block-permutation $p = \MantelWithinSubfamilyBlockP {}$, dyadic $p = \MantelWithinSubfamilyP {}$). Across Indo-European branches (amber, $n = \MantelCrossBranchIEPairs {}$), correlation weakens ($\rho _s = \MantelCrossBranchIERho {}$), and across unrelated language families (red, $n = \MantelBetweenFamilyPairs {}$), ASJP distance saturates near ceiling ($\rho _s = \MantelBetweenFamilyRho {}$). Pooled carrier-frame Mantel $\rho _s = \MantelRho {}$ ($p = \MantelP {}$); decontextualized bare-word Mantel $\rho _s = \MantelBareRho {}$ ($p = \MantelBareP {}$)}{figure.caption.18}{}}
