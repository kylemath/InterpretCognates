\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cross-lingual convergence by semantic category across 101{} Swadesh concepts (135{} languages, ABTT-corrected $k=3$). Violins and jittered points show per-concept scores; the vertical dashed line indicates the grand mean ($0.58{}$). Perceptually grounded noun categories (People $\mu = 0.77{}$, Nature $\mu = 0.72{}$) converge most strongly, whereas grammatical Pronouns ($\mu = 0.45{}$) converge least.}}{13}{figure.caption.11}\protected@file@percent }
\newlabel{fig:category_summary}{{5}{13}{Cross-lingual convergence by semantic category across \NumConcepts {} Swadesh concepts (\NumLanguages {} languages, ABTT-corrected $k=3$). Violins and jittered points show per-concept scores; the vertical dashed line indicates the grand mean ($\SwadeshMean {}$). Perceptually grounded noun categories (People $\mu = \CatPeopleMean {}$, Nature $\mu = \CatNatureMean {}$) converge most strongly, whereas grammatical Pronouns ($\mu = \CatPronounsMean {}$) converge least}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-concept ABTT-corrected convergence scores for all 101{} Swadesh items grouped by semantic category (sorted by category mean). Individual within-category outliers reflect English lexical polysemy (e.g., \emph  {bark, lie, fly}) or low-frequency rural/archaic vocabulary (\emph  {louse, grease}).}}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig:category_detail}{{6}{14}{Per-concept ABTT-corrected convergence scores for all \NumConcepts {} Swadesh items grouped by semantic category (sorted by category mean). Individual within-category outliers reflect English lexical polysemy (e.g., \emph {bark, lie, fly}) or low-frequency rural/archaic vocabulary (\emph {louse, grease})}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Validation of All-But-The-Top (ABTT) isotropy correction. (a) Raw vs.\ ABTT-corrected ($k=3$) convergence across all 101{} concepts ($\rho _s = 0.990{}$, $p = 4.93 \times 10^{-87}{}$). Removing the top 3 principal components eliminates the baseline anisotropic floor ($\sim 0.43$--$0.91 \to 0.12{}$--$0.91{}$) while preserving rank order. (b) Top-10 and bottom-10 concepts before and after correction. (c) Hyperparameter sensitivity across $k \in \{0, 1, 3, 5, 10\}$: all rankings correlate at $\rho _s \in [0.98{}, 1.00{}]$ with the $k=3$ reference.}}{15}{figure.caption.13}\protected@file@percent }
\newlabel{fig:isotropy_validation}{{7}{15}{Validation of All-But-The-Top (ABTT) isotropy correction. (a) Raw vs.\ ABTT-corrected ($k=3$) convergence across all \NumConcepts {} concepts ($\rho _s = \IsotropySpearmanRho {}$, $p = \IsotropySpearmanP {}$). Removing the top 3 principal components eliminates the baseline anisotropic floor ($\sim 0.43$--$0.91 \to \SwadeshMin {}$--$\SwadeshMax {}$) while preserving rank order. (b) Top-10 and bottom-10 concepts before and after correction. (c) Hyperparameter sensitivity across $k \in \{0, 1, 3, 5, 10\}$: all rankings correlate at $\rho _s \in [\IsotropyMinRho {}, \IsotropyMaxRho {}]$ with the $k=3$ reference}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Comparison of Swadesh concept convergence in the shared English carrier frame vs.\ decontextualized native bare words across 135{} languages. (a) Concept-level scatter shows strong rank-order invariance ($\rho _s = 0.866{}$, $p = 1.48 \times 10^{-31}{}$) alongside a systematic upward shift in absolute convergence induced by the shared English carrier frame ($\mu _{\text  {ctx}} = 0.58{}$ vs.\ $\mu _{\text  {bare}} = 0.45{}$, $\Delta \mu = +0.129{}$, paired $t = 15.74{}$, $p = 7.97 \times 10^{-29}{}$). (b) Slopegraph of top-ranked concepts confirming stability of concrete universals across both regimes.}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:carrier_baseline}{{8}{15}{Comparison of Swadesh concept convergence in the shared English carrier frame vs.\ decontextualized native bare words across \NumLanguages {} languages. (a) Concept-level scatter shows strong rank-order invariance ($\rho _s = \CarrierBaselineRho {}$, $p = \CarrierBaselineP {}$) alongside a systematic upward shift in absolute convergence induced by the shared English carrier frame ($\mu _{\text {ctx}} = \CarrierCtxMean {}$ vs.\ $\mu _{\text {bare}} = \CarrierDectxMean {}$, $\Delta \mu = +\CarrierBaselineMeanDiff {}$, paired $t = \CarrierBaselineTstat {}$, $p = \CarrierBaselineTp {}$). (b) Slopegraph of top-ranked concepts confirming stability of concrete universals across both regimes}{figure.caption.14}{}}
