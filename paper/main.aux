\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Two-dimensional PCA projection of Swadesh concept embeddings pooled across 19 language families (101{} concepts $\times $ 135{} languages). Translucent dots represent per-family concept centroids; shaded convex hulls enclose semantic categories; large opaque markers indicate global cross-lingual centroids $\boldsymbol  {\mu }_c$. Concept centroids organize by semantic domain (e.g., Pronouns, People, Body Parts, Nature) rather than collapsing by language family.}}{12}{figure.caption.10}\protected@file@percent }
\newlabel{fig:concept_map}{{4}{12}{Two-dimensional PCA projection of Swadesh concept embeddings pooled across 19 language families (\NumConcepts {} concepts $\times $ \NumLanguages {} languages). Translucent dots represent per-family concept centroids; shaded convex hulls enclose semantic categories; large opaque markers indicate global cross-lingual centroids $\boldsymbol {\mu }_c$. Concept centroids organize by semantic domain (e.g., Pronouns, People, Body Parts, Nature) rather than collapsing by language family}{figure.caption.10}{}}
